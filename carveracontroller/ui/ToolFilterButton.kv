<ToolFilterButton>:
    height: dp(48) if app.show_gcode_ctl_bar else 0
    size_hint_y: None
    size_hint_x: None
    background_color: 0, 0, 0, 0
    color: 0, 0, 0, 0
    disabled_color: 0, 0, 0, 0
    # Keep Button/Label text empty; caption is drawn by the child Label.
    text: ''
    # Keep in sync with the Mesh position below.
    icon_rect: [icon_label.x + dp(root.icon_pad_x), icon_label.center_y - dp(root.icon_size / 2) + (dp(4) if root.min_icon else 0), dp(root.icon_size), dp(root.icon_size)] if root.has_tool_icon else [0, 0, 0, 0]
    Label:
        id: icon_label
        text: root.label_text
        # Same valign pattern as TransparentButton: top when an eye is shown
        # without a leading silhouette, middle when the silhouette is present.
        halign: 'right' if root.has_tool_icon else 'center'
        valign: 'middle' if root.has_tool_icon else ('top' if root.min_icon else 'middle')
        # Same text_size pattern as TransparentButton. Negative heights are OK:
        # Label.refresh() early-outs when height <= 1. Do not clamp to 1 — that
        # forces a real texture upload and can hit a Kivy UnboundLocalError in
        # _render_real for some size/valign combinations.
        text_size: (self.width - dp(root.icon_size + 2 * root.icon_pad_x) if root.has_tool_icon else self.width), (self.height - dp(root.min_icon_size + 12) if root.min_icon else (self.height if root.has_tool_icon else None))
        color: tuple(app.active_color) if (root.active and not root.disabled) else ((110/255, 110/255, 110/255, 1) if root.disabled else (250/255, 250/255, 250/255, 1))
        canvas.before:
            # Generated tool silhouettes: Mesh fill + outline. Greyscale
            # variants are applied via Color properties from Python.
            Color:
                rgba: root.icon_flute_color
            Mesh:
                mode: 'triangles'
                vertices: root.icon_flute_vertices
                indices: root.icon_flute_indices
            Color:
                rgba: root.icon_shank_color
            Mesh:
                mode: 'triangles'
                vertices: root.icon_shank_vertices
                indices: root.icon_shank_indices
            Color:
                rgba: root.icon_outline_color
            Line:
                points: root.icon_outline_points
                width: dp(root.icon_outline_width)
                joint: 'round'
                cap: 'round'
                close: False
            Color:
                rgba: (250/255, 250/255, 250/255, 1) if root.min_active else (60/255, 60/255, 60/255, 1)
            Rectangle:
                source: root.min_icon if root.min_icon and not root.disabled else ''
                pos: self.center_x - dp(root.min_icon_size / 2), self.y + dp(1)
                size: dp(root.min_icon_size) if root.min_icon and not root.disabled else 0, dp(root.min_icon_size) if root.min_icon and not root.disabled else 0
